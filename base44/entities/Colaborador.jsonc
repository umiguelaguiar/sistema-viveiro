{
  "name": "Colaborador",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "description": "Data de admiss\u00e3o"
    },
    "funcao": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o do colaborador"
    },
    "status_colaborador": {
      "type": "string",
      "enum": [
        "ativo",
        "afastado",
        "desligado"
      ],
      "default": "ativo",
      "description": "Status do colaborador"
    },
    "data_saida": {
      "type": "string",
      "format": "date",
      "description": "Data de desligamento"
    },
    "motivo_saida": {
      "type": "string",
      "enum": [
        "pedido_demissao",
        "demissao",
        "acordo",
        "aposentadoria",
        "outro"
      ],
      "description": "Motivo do desligamento"
    },
    "observacao_saida": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre o desligamento"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Compatibilidade legada"
    }
  },
  "required": [
    "nome",
    "data_admissao",
    "funcao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    }
  }
}
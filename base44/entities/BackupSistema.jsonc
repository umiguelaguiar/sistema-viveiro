{
  "name": "BackupSistema",
  "type": "object",
  "properties": {
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da execu\u00e7\u00e3o do backup"
    },
    "tipo_backup": {
      "type": "string",
      "enum": [
        "autom\u00e1tico",
        "manual"
      ],
      "description": "Tipo de backup: autom\u00e1tico ou manual"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "Email do usu\u00e1rio que executou o backup"
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro",
        "parcial"
      ],
      "description": "Status da execu\u00e7\u00e3o"
    },
    "descricao_erro": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do erro (se houver)"
    },
    "tamanho_arquivo": {
      "type": "number",
      "description": "Tamanho do arquivo em MB"
    },
    "nome_arquivo": {
      "type": "string",
      "description": "Nome do arquivo gerado"
    },
    "local_armazenamento": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local",
          "google_drive",
          "aws_s3"
        ]
      },
      "description": "Locais onde o backup foi armazenado"
    },
    "link_arquivo": {
      "type": "string",
      "description": "URL do arquivo (se armazenado externamente)"
    },
    "hash_integridade": {
      "type": "string",
      "description": "Hash SHA-256 do arquivo para valida\u00e7\u00e3o"
    },
    "tempo_execucao": {
      "type": "number",
      "description": "Tempo de execu\u00e7\u00e3o em segundos"
    },
    "total_registros": {
      "type": "number",
      "description": "Total de registros salvos"
    },
    "entidades_backup": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entidade": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      },
      "description": "Lista de entidades e quantidades em backup"
    },
    "restaurado": {
      "type": "boolean",
      "default": false,
      "description": "Indica se este backup foi usado para restaura\u00e7\u00e3o"
    }
  },
  "required": [
    "data_hora",
    "tipo_backup",
    "status",
    "nome_arquivo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
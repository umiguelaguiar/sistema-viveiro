{
  "name": "SolicitacaoAcesso",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "nome": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem ou motivo da solicita\u00e7\u00e3o"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "usuario"
          }
        },
        {
          "user_condition": {
            "role": "visitante"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
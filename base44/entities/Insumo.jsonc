{
  "name": "Insumo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do insumo"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida"
    }
  },
  "required": [
    "nome",
    "unidade"
  ],
  "rls": {

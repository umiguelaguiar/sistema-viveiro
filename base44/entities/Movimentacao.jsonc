{
  "name": "Movimentacao",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "transferencia",
        "expedicao"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote"
    },
    "clone_id": {
      "type": "string",
      "description": "ID do clone"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada"
    },
    "setor_origem_id": {
      "type": "string",
      "description": "ID do setor de origem"
    },
    "setor_destino_id": {
      "type": "string",
      "description": "ID do setor de destino"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da movimenta\u00e7\u00e3o"
    }
  },
  "required": [
    "tipo",
    "lote_id",
    "clone_id",
    "quantidade",
    "data"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "usuario"
          }
        },
        {
          "user_condition": {
            "role": "secretaria"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "usuario"
          }
        },
        {
          "user_condition": {
            "role": "secretaria"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
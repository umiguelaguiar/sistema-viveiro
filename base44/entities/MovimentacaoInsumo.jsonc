{
  "name": "MovimentacaoInsumo",
  "type": "object",
  "properties": {
    "insumo_id": {
      "type": "string",
      "description": "ID do insumo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da movimenta\u00e7\u00e3o"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote (opcional)"
    },
    "clone_id": {
      "type": "string",
      "description": "ID do clone (opcional)"
    }
  },
  "required": [
    "insumo_id",
    "tipo",
    "quantidade",
    "data"
  ]
}